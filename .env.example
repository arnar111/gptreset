# Codex Reset Tracker push worker.
# Copy the values you need into backend/.dev.vars (local) or `wrangler secret put` (deployed).
# Do not commit real keys. The .p8 file stays on your machine.

APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.arnar111.codexresettracker
APNS_PRIVATE_KEY=

# Optional override. Defaults live in backend/wrangler.toml.
# CODEX_RESETS_STATUS_URL=https://codex-resets.com/api/v1/status
# CODEX_RESETS_LIST_URL=https://codex-resets.com/api/v1/resets?limit=20&order=desc
